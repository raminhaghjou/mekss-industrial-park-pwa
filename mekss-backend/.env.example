# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://mekss_user:mekss_password@localhost:5432/mekss
DB_NAME=mekss
DB_USER=mekss_user
DB_PASSWORD=mekss_password
DB_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SESSION_SECRET=your-session-secret-change-this-in-production

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_CONSOLE_PORT=9001
# Docker Compose only: MinIO server image (minio/minio is no longer published on Docker Hub)
# MEKSS_MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# SMS. The super admin sets the provider and Melipayamak credentials in the panel (Settings → SMS);
# they are stored in the database with the API key encrypted. Values below are fallbacks for any
# field left empty in the panel. SMS_PROVIDER=melipayamak|kavenegar|mock (default: melipayamak;
# outside production an unconfigured Melipayamak only logs messages).
SMS_PROVIDER=
MELIPAYAMAK_USERNAME=
# Panel password or, preferably, the API key from the Melipayamak console
MELIPAYAMAK_PASSWORD=
# Dedicated sender line for plain messages
MELIPAYAMAK_SENDER=
# Approved pattern (shared service line) for login codes, with one variable: the code. Recommended:
# unlike plain sends it also reaches numbers on the operators' advertising blacklist.
MELIPAYAMAK_OTP_BODY_ID=
# Key that encrypts secrets saved from the admin panel (falls back to JWT_SECRET). Changing it
# makes stored secrets unreadable; re-enter them in the panel.
SETTINGS_ENCRYPTION_KEY=
# Kavenegar (alternative provider)
KAVEH_NEGAR_API_KEY=your-kaveh-negar-api-key
SMS_SENDER=1000596446

# Payment Configuration (ZarinPal)
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_CALLBACK_URL=http://localhost:3000/api/v1/invoices/payment/verify
ZARINPAL_SANDBOX=true
# Wallet top-up gateway callback (defaults to <ZARINPAL_CALLBACK_URL origin>/api/v1/wallet/payment/callback)
ZARINPAL_WALLET_CALLBACK_URL=http://localhost:3000/api/v1/wallet/payment/callback
# PAYMENT_PROVIDER=mock|zarinpal. The mock gateway credits wallets without real payment, so it is
# refused when NODE_ENV=production unless PAYMENT_ALLOW_MOCK=true.
PAYMENT_PROVIDER=mock
PAYMENT_ALLOW_MOCK=false

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Logging Configuration
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Security Configuration
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173

# Monitoring
HEALTH_CHECK_INTERVAL=30000

# Live plate recognition (ANPR)
# Engine A: Python service (mekss-anpr). Engine B: in-process onnxruntime-node fallback.
ANPR_SERVICE_URL=http://localhost:8000
# Per-request timeouts for engine A. Live frames need ~0.3-0.8 s on a small VPS (values below 1000 are raised);
# still photos run multi-scale + tiled detection. ANPR_TIMEOUT_MS is still read as the live timeout.
ANPR_LIVE_TIMEOUT_MS=1500
ANPR_PHOTO_TIMEOUT_MS=8000
ANPR_POOL_CONNECTIONS=16
# Consecutive engine-A failures before switching to engine B, and how long before probing A again.
ANPR_BREAKER_FAILURES=3
ANPR_BREAKER_COOLDOWN_MS=30000
# ONNX models for engine B. When unset/missing the engine also looks in ../mekss-anpr/models(/bundled)
# and ../mekss-industrial-park/public/models/iran-plate, so a local checkout works without downloads.
ANPR_MODEL_DIR=./models/iran-plate
ANPR_NODE_CONCURRENCY=2
# Requests waiting for a free engine-B slot (instead of failing with "busy")
ANPR_NODE_QUEUE=6
# Load + warm engine B at startup (set false to load lazily on the first frame)
ANPR_NODE_WARMUP=true
ANPR_NODE_THREADS=2
ANPR_TTA=1
# Open-plate cache used by the matcher (invalidated on every gate-pass change)
ANPR_MATCH_CACHE_TTL_MS=20000
# Audit: store frame + plate crop in MinIO bucket "plate-reads"; images purged after N days, rows after M days
ANPR_AUDIT_IMAGES=true
ANPR_AUDIT_RETENTION_DAYS=90
ANPR_AUDIT_ROW_RETENTION_DAYS=365