generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PARK_MANAGER
  FACTORY_OWNER
  SECURITY_GUARD
  GOVERNMENT_OFFICIAL
  EMPLOYEE
}

enum RequestType {
  MISSION
  TRANSFER
  DAILY_LEAVE
  HOURLY_LEAVE
  LOAN
  SETTLEMENT
  CONSTRUCTION_PERMIT
  FINAL_INSPECTION
  APPOINTMENT
  SERVICE_ORDER
  OTHER
}

enum ServiceOrderKind {
  FOOD
  CLEANING
  FREIGHT
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  PENDING
  /// Gateway verified money; awaiting park-manager confirmation per docs.
  AWAITING_CONFIRMATION
  PAID
  OVERDUE
  CANCELLED
  /// Split into child installment invoices; the parent is no longer payable itself.
  INSTALLMENTS
}

/// Who the invoice bills: an industrial unit, or the park itself (admin → park manager).
enum InvoiceTarget {
  FACTORY
  PARK
}

/// CHARGE = park-manager charge bills; PLATFORM = super-admin entrance/membership bills.
enum InvoiceCategory {
  CHARGE
  PLATFORM
}

enum InvoiceItemType {
  WATER
  SEWAGE
  RENOVATION_SHARE
  SHARE_DEBT
  CHARGE_OTHER
  ENTRANCE_FEE
  MONTHLY_MEMBERSHIP
  PLATFORM_OTHER
  /// Carried late penalty of a parent invoice that was split into installments.
  CARRIED_PENALTY
}

enum InvoiceAdjustmentType {
  EDIT
  DISCOUNT
  EXTENSION
  SETTLEMENT
  INSTALLMENT
}

enum PaymentStatus {
  INITIATED
  VERIFIED
  FAILED
  CANCELLED
}

enum GatePassStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  EXPIRED
}

enum CargoType {
  RAW_MATERIALS
  FINISHED_GOODS
  WASTE
  SUPPLIES
  EQUIPMENT
  OTHER
}

enum VehicleType {
  /// Legacy: kept for old gate passes, no longer accepted for new ones.
  TRUCK
  VAN
  CAR
  MOTORCYCLE
  OTHER
  KHAVAR
  TAK
  TEN_WHEELER
  TRAILER
}

/// Iranian plate category, derived from the plate letter / background colour.
enum PlateType {
  PRIVATE
  PUBLIC
  TAXI
  GOVERNMENT
  POLICE
  MILITARY
  DISABLED
  AGRICULTURAL
  FREE_ZONE
  OTHER
}

enum PlateReadEngine {
  PYTHON
  NODE
  DEVICE
  MANUAL
}

enum PlateReadOutcome {
  MATCHED
  SUGGESTED
  NOT_FOUND
  UNREADABLE
  CONFIRMED
  CORRECTED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum FactoryStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ParkStatus {
  ACTIVE
  INACTIVE
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

enum AdvertisementStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum MarketRateKey {
  USD
  EUR
  CNY
  IRON
  GOLD
  SILVER
  PLATINUM
  COIN
  COPPER
  ALUMINUM
  OIL
  BITUMEN
  USDT
  BTC
  ETH
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  SENSITIVE_ACTION
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  EMERGENCY
}

enum EmergencySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmergencyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum NotificationChannel {
  SMS
  IN_APP
}

enum NotificationDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

model User {
  id                 String    @id @default(cuid())
  phoneNumber        String    @unique
  username           String?   @unique
  password           String
  name               String
  nationalId         String?   @unique
  email              String?   @unique
  role               Role      @default(EMPLOYEE)
  isApproved         Boolean   @default(false)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  // Incremented whenever access or credentials change so already-issued access tokens become stale immediately.
  sessionVersion     Int       @default(0)
  // A single, non-null sentinel identifies the exact-once production bootstrap account.
  bootstrapKey       String?   @unique
  bootstrapCreatedAt DateTime?
  avatar             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime?

  // Sub-user support (section 8): an employee registers under a specific
  // factory, is approved by that factory's owner, and is restricted to the
  // request types listed in canApproveRequestTypes rather than a hardcoded role.
  employeeOfFactoryId    String?
  employeeOfFactory      Factory?        @relation("FactoryEmployee", fields: [employeeOfFactoryId], references: [id], onDelete: SetNull)
  // Park-office staff managed by a park manager (same EMPLOYEE role, park scope).
  employeeOfParkId       String?
  employeeOfPark         IndustrialPark? @relation("ParkEmployee", fields: [employeeOfParkId], references: [id], onDelete: SetNull)
  canApproveRequestTypes RequestType[]   @default([])
  // Park managers may opt out of receiving unsolicited factory-to-manager messages.
  messagingRestricted    Boolean         @default(false)
  // A default driver/vehicle snapshot offered as a starting point on the next gate pass form.
  defaultDriver          Json?
  // Self-registration: factory owners / employees request access to a specific park until approved.
  requestedParkId        String?
  requestedPark          IndustrialPark? @relation("UserRequestedPark", fields: [requestedParkId], references: [id], onDelete: SetNull)

  managedFactories        Factory[]               @relation("FactoryOwner")
  managedParks            IndustrialPark[]        @relation("ParkManager")
  gatePassesCreated       GatePass[]              @relation("GatePassCreator")
  gatePassesApproved      GatePass[]              @relation("GatePassApprover")
  gatePassesVerified      GatePass[]              @relation("GatePassVerifier")
  invoicesCreated         Invoice[]               @relation("InvoiceCreator")
  invoicesPaid            Invoice[]               @relation("InvoicePayer")
  messagesSent            Message[]               @relation("MessageSender")
  messagesReceived        Message[]               @relation("MessageReceiver")
  requestsCreated         Request[]               @relation("RequestCreator")
  requestsApproved        Request[]               @relation("RequestApprover")
  announcements           Announcement[]
  advertisements          Advertisement[]         @relation("AdvertisementCreator")
  moderatedAdvertisements Advertisement[]         @relation("AdvertisementModerator")
  reviewedFactories       Factory[]               @relation("FactoryReviewer")
  favoriteAdvertisements  AdvertisementFavorite[]
  securityShifts          SecurityGuard[]         @relation("SecurityUser")
  refreshTokens           RefreshToken[]
  otpChallenges           OtpChallenge[]
  notifications           Notification[]
  emergencies             EmergencyAlert[]        @relation("EmergencyCreator")
  auditLogs               AuditLog[]              @relation("AuditActor")
  paymentAttempts         PaymentTransaction[]    @relation("PaymentInitiator")
  uploadedFiles           ScopedFile[]            @relation("ScopedFileUploader")
  mediaAssets             MediaAsset[]            @relation("MediaAssetUploader")
  feedbackSent            Feedback[]              @relation("FeedbackSender")
  marketRateUpdates       MarketRate[]            @relation("MarketRateUpdater")
  plateReads              PlateReadEvent[]        @relation("PlateReadGuard")
  invoiceAdjustments      InvoiceAdjustment[]     @relation("InvoiceAdjustmentActor")
  invoiceImportBatches    InvoiceImportBatch[]    @relation("InvoiceImportCreator")
  dashboardBanners        DashboardBanner[]       @relation("DashboardBannerCreator")
  emergenciesResolved     EmergencyAlert[]        @relation("EmergencyResolver")
  walletTopUps            WalletTopUp[]           @relation("WalletTopUpInitiator")

  @@index([role, isApproved, isActive])
  @@index([bootstrapCreatedAt])
  @@index([employeeOfFactoryId])
  @@index([employeeOfParkId])
  @@index([requestedParkId, isApproved, role])
}

model IndustrialPark {
  id              String     @id @default(cuid())
  code            String     @unique
  name            String
  province        String
  city            String
  address         String
  phoneNumber     String
  email           String?
  guardPhone      String
  totalArea       Int        @default(0)
  totalFactories  Int        @default(0)
  activeFactories Int        @default(0)
  establishedDate DateTime?
  description     String?
  logo            String?
  status          ParkStatus @default(ACTIVE)
  /// Accumulated park share of gate-pass wallet fees.
  gatePassFeeRevenue Decimal @default(0) @db.Decimal(15, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  factories      Factory[]
  managers       User[]          @relation("ParkManager")
  staff          User[]          @relation("ParkEmployee")
  registrationRequests User[]    @relation("UserRequestedPark")
  announcements  Announcement[]
  advertisements Advertisement[] @relation("AdvertisementPark")
  securityGuards SecurityGuard[]
  emergencies    EmergencyAlert[]
  invoices       Invoice[]
  payments       PaymentTransaction[] @relation("PaymentPark")
  scopedFiles    ScopedFile[]
  feedback       Feedback[]      @relation("FeedbackRecipientPark")
  plateReads     PlateReadEvent[]
  banners        DashboardBanner[]

  @@index([province, city])
  @@index([status])
}

model Factory {
  id              String        @id @default(cuid())
  name            String
  licenseNumber   String        @unique
  licenseExpiry   DateTime?
  nationalId      String        @unique
  activityType    String
  address         String
  location        Json?
  phoneNumber     String
  phoneNumber2    String?
  landline        String?
  fax             String?
  email           String?
  website         String?
  description     String?
  establishedDate DateTime?
  employees       Int           @default(0)
  status          FactoryStatus @default(PENDING)
  isApproved      Boolean       @default(false)
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Public directory / registration-form fields (section 1 & 5).
  logo           String?
  ceoName        String?
  socialMedia    Json?
  shopUrl        String?
  latitude       Float?
  longitude      Float?
  // Prepaid balance deducted when creating gate passes.
  gatePassWalletBalance Decimal @default(0) @db.Decimal(15, 2)
  // Sensitive-field edits are staged here until the managing park manager approves them.
  pendingChanges Json?
  // Set while status = SUSPENDED (blocked by the park manager / super admin).
  suspendedReason String?
  suspendedAt     DateTime?

  managerId     String
  manager       User              @relation("FactoryOwner", fields: [managerId], references: [id])
  reviewedById  String?
  reviewedBy    User?             @relation("FactoryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  parkId        String
  park          IndustrialPark    @relation(fields: [parkId], references: [id])
  employeesList FactoryEmployee[]
  subUsers      User[]            @relation("FactoryEmployee")
  gatePasses    GatePass[]
  invoices      Invoice[]
  requests      Request[]
  announcements Announcement[]
  scopedFiles   ScopedFile[]      @relation("FactoryScopedFiles")
  walletTopUps  WalletTopUp[]

  @@unique([id, parkId])
  @@index([managerId])
  @@index([parkId, status])
  @@index([parkId, status, isApproved])
  @@index([isApproved])
  @@index([reviewedById, reviewedAt])
}

model FactoryEmployee {
  id               String         @id @default(cuid())
  name             String
  phoneNumber      String
  nationalId       String         @unique
  email            String?        @unique
  position         String
  department       String
  hireDate         DateTime
  salary           Decimal        @db.Decimal(15, 2)
  status           EmployeeStatus @default(ACTIVE)
  emergencyContact String?
  address          String?
  birthDate        DateTime?
  avatar           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  factoryId String
  factory   Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([factoryId, status])
  @@index([phoneNumber])
}

model GatePass {
  id                String         @id @default(cuid())
  cargoType         CargoType
  cargoDescription  String?
  driverName        String
  driverNationalId  String
  driverPhone       String
  vehicleType       VehicleType
  licensePlate      String
  plateType         PlateType      @default(PRIVATE)
  licensePlatePhoto String?
  exitDate          DateTime
  entryDate         DateTime?
  status            GatePassStatus @default(PENDING)
  notes             String?
  qrCode            String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  verifiedAt        DateTime?
  /// When the park manager approved or rejected the pass (first review stage).
  approvedAt        DateTime?

  factoryId    String
  factory      Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User    @relation("GatePassCreator", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?   @relation("GatePassApprover", fields: [approvedById], references: [id])
  verifiedById String?
  verifiedBy   User?   @relation("GatePassVerifier", fields: [verifiedById], references: [id])
  plateReads   PlateReadEvent[]

  @@index([factoryId, status])
  @@index([createdAt])
  @@index([driverNationalId])
  @@index([licensePlate])
  @@index([status, licensePlate])
}

/// One plate recognition at a gate (live scan, device fallback or manual entry).
/// Guard confirmations/corrections make these rows labelled data for model evaluation.
model PlateReadEvent {
  id             String           @id @default(cuid())
  sessionId      String?
  rawText        String
  plate          String
  plateType      PlateType?
  confidence     Float
  engine         PlateReadEngine
  outcome        PlateReadOutcome
  correctedPlate String?
  frames         Int              @default(1)
  latencyMs      Int?
  bbox           Json?
  imageKey       String?
  cropKey        String?
  confirmedAt    DateTime?
  createdAt      DateTime         @default(now())

  guardId    String
  guard      User            @relation("PlateReadGuard", fields: [guardId], references: [id], onDelete: Cascade)
  parkId     String?
  park       IndustrialPark? @relation(fields: [parkId], references: [id], onDelete: SetNull)
  gatePassId String?
  gatePass   GatePass?       @relation(fields: [gatePassId], references: [id], onDelete: SetNull)

  @@index([parkId, createdAt])
  @@index([plate])
  @@index([guardId, createdAt])
  @@index([gatePassId])
  @@index([createdAt])
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String        @unique
  amount             Decimal       @db.Decimal(15, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount        Decimal       @db.Decimal(15, 2)
  /// Daily late-payment penalty (Rials) applied for each calendar day after dueDate until paid.
  latePenaltyPerDay  Decimal       @default(0) @db.Decimal(15, 2)
  /// Frozen late days at payment time (null while unpaid).
  lateDays           Int?
  /// Frozen accrued late penalty at payment time; while unpaid this is computed live.
  latePenaltyAmount  Decimal       @default(0) @db.Decimal(15, 2)
  description        String
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  status             InvoiceStatus @default(PENDING)
  paymentDate        DateTime?
  paymentMethod      String?
  paymentRef         String?       @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  /// FACTORY = bill an industrial unit; PARK = bill the park (super-admin → park manager).
  targetType  InvoiceTarget @default(FACTORY)
  factoryId   String?
  factory     Factory?             @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  parkId      String?
  park        IndustrialPark?      @relation(fields: [parkId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User                 @relation("InvoiceCreator", fields: [createdById], references: [id])
  paidById    String?
  paidBy      User?                @relation("InvoicePayer", fields: [paidById], references: [id])
  payments    PaymentTransaction[]

  category        InvoiceCategory @default(CHARGE)
  /// Discount on the base (amount + tax); never applied to the late penalty.
  discountAmount  Decimal         @default(0) @db.Decimal(15, 2)
  /// When set, late days count from here instead of dueDate (due date extended after the penalty began).
  penaltyStartsAt DateTime?
  parentInvoiceId String?
  parentInvoice   Invoice?            @relation("InvoiceInstallments", fields: [parentInvoiceId], references: [id], onDelete: Restrict)
  installments    Invoice[]           @relation("InvoiceInstallments")
  installmentNo   Int?
  importBatchId   String?
  importBatch     InvoiceImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
  adjustments     InvoiceAdjustment[]

  @@index([factoryId, status])
  @@index([parkId, status])
  @@index([targetType, status])
  @@index([dueDate])
  @@index([parentInvoiceId])
  @@index([importBatchId])
}

model InvoiceItem {
  id        String          @id @default(cuid())
  type      InvoiceItemType
  title     String?
  amount    Decimal         @db.Decimal(15, 2)
  sortOrder Int             @default(0)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
}

/// Audit trail of park-manager / issuer operations, visible to the billed unit.
model InvoiceAdjustment {
  id          String                @id @default(cuid())
  type        InvoiceAdjustmentType
  amount      Decimal?              @db.Decimal(15, 2)
  fromDueDate DateTime?
  toDueDate   DateTime?
  note        String?
  details     Json?
  createdAt   DateTime              @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User    @relation("InvoiceAdjustmentActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([invoiceId, createdAt])
}

model InvoiceImportBatch {
  id        String          @id @default(cuid())
  fileName  String
  fileHash  String
  category  InvoiceCategory
  rowCount  Int
  createdAt DateTime        @default(now())

  createdById String
  createdBy   User      @relation("InvoiceImportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  invoices    Invoice[]

  @@unique([createdById, fileHash])
}

/// Rotating promotional banner shown at the top of every dashboard.
model DashboardBanner {
  id             String    @id @default(cuid())
  title          String
  desktopImageId String
  mobileImageId  String
  linkUrl        String?
  openInNewTab   Boolean   @default(true)
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  clickCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// null = shown in every park.
  parkId      String?
  park        IndustrialPark? @relation(fields: [parkId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User            @relation("DashboardBannerCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([isActive, sortOrder])
  @@index([parkId])
}

model PaymentTransaction {
  id             String        @id @default(cuid())
  authority      String        @unique
  amount         Decimal       @db.Decimal(15, 2)
  status         PaymentStatus @default(INITIATED)
  provider       String        @default("ZARINPAL")
  referenceId    String?       @unique
  providerStatus Json?
  verifiedAt     DateTime?
  failureReason  String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Park that receives the payment (from invoice.parkId or factory.parkId).
  parkId        String?
  park          IndustrialPark? @relation("PaymentPark", fields: [parkId], references: [id], onDelete: SetNull)
  initiatedById String?
  initiatedBy   User?   @relation("PaymentInitiator", fields: [initiatedById], references: [id])

  @@index([invoiceId, status])
  @@index([parkId, status])
  @@index([status, createdAt])
}

/// Gate-pass wallet credit: online gateway payments by the unit owner, or manual credit by park staff.
model WalletTopUp {
  id             String        @id @default(cuid())
  amount         Decimal       @db.Decimal(15, 2)
  status         PaymentStatus @default(INITIATED)
  /// ONLINE (payment gateway) or MANUAL (credited by a park manager / super admin).
  method         String        @default("ONLINE")
  provider       String        @default("MOCK")
  authority      String        @unique
  referenceId    String?       @unique
  providerStatus Json?
  failureReason  String?
  note           String?
  balanceAfter   Decimal?      @db.Decimal(15, 2)
  verifiedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  factoryId     String
  factory       Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  initiatedById String?
  initiatedBy   User?   @relation("WalletTopUpInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  @@index([factoryId, createdAt])
  @@index([status, createdAt])
}

model Message {
  id          String        @id @default(cuid())
  subject     String
  body        String        @db.Text
  attachments String[]      @default([])
  status      MessageStatus @default(UNREAD)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  senderId   String
  sender     User   @relation("MessageSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@index([receiverId, status])
  @@index([createdAt])
}

model Request {
  id              String          @id @default(cuid())
  type            RequestType
  title           String
  description     String          @db.Text
  // Structured per-type fields (Mission/Transfer/DailyLeave/HourlyLeave/SalaryAdvance/
  // Settlement/ConstructionPermit/FinalInspection/Appointment/ServiceOrder) validated
  // per-type by CreateRequestDto's discriminated payload, persisted as JSON.
  data            Json
  attachments     String[]
  status          RequestStatus   @default(PENDING)
  priority        RequestPriority @default(MEDIUM)
  // Whether this request targets the factory's own internal approver chain
  // (isToParkManager = false) or the managing park manager (true).
  isToParkManager Boolean         @default(false)
  appointmentSlot DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  creatorId  String
  creator    User    @relation("RequestCreator", fields: [creatorId], references: [id])
  approverId String?
  approver   User?   @relation("RequestApprover", fields: [approverId], references: [id])
  factoryId  String
  factory    Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([factoryId, status])
  @@index([creatorId, createdAt])
  @@index([isToParkManager, status])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String    @db.Text
  isGlobal  Boolean   @default(false)
  isPinned  Boolean   @default(false)
  priority  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  // Scope ladder (exactly one active level):
  // - isGlobal=true, parkId/factoryId null → entire platform
  // - parkId set, factoryId null → park-wide (factory managers + guards)
  // - factoryId set (+ parkId of that factory) → that industrial unit only
  parkId      String?
  park        IndustrialPark? @relation(fields: [parkId], references: [id], onDelete: Restrict)
  factoryId   String?
  factory     Factory?        @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])

  @@index([parkId, createdAt])
  @@index([factoryId, createdAt])
  @@index([isGlobal, createdAt])
}

// Admin-manageable ad categories (section 9) replace the previous fixed enum
// so a super-admin can add/remove categories without a schema migration.
model AdvertisementCategoryDef {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  advertisements Advertisement[]

  @@index([isActive])
}

model Advertisement {
  id              String                   @id @default(cuid())
  title           String
  categoryId      String
  category        AdvertisementCategoryDef @relation(fields: [categoryId], references: [id])
  province        String
  city            String
  address         String?
  content         String                   @db.Text
  price           Decimal?                 @db.Decimal(15, 2)
  contactInfo     Json
  images          String[]
  status          AdvertisementStatus      @default(PENDING)
  isApproved      Boolean                  @default(false)
  rejectionReason String?
  // Optional paid/admin-approved placement in the ads slider, capped monthly.
  isFeatured      Boolean                  @default(false)
  featuredUntil   DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  expiresAt       DateTime?

  createdById   String
  createdBy     User                    @relation("AdvertisementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  parkId        String?
  park          IndustrialPark?         @relation("AdvertisementPark", fields: [parkId], references: [id], onDelete: Restrict)
  moderatedById String?
  moderatedBy   User?                   @relation("AdvertisementModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt   DateTime?
  favoritedBy   AdvertisementFavorite[]

  @@index([categoryId, status])
  @@index([province, city])
  @@index([createdAt])
  @@index([parkId, status])
  @@index([moderatedById, moderatedAt])
  @@index([isFeatured, featuredUntil])
}

model AdvertisementFavorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  @@unique([userId, advertisementId])
  @@index([userId])
}

model SecurityGuard {
  id         String   @id @default(cuid())
  shiftStart DateTime
  shiftEnd   DateTime
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  userId String
  user   User           @relation("SecurityUser", fields: [userId], references: [id], onDelete: Cascade)
  parkId String
  park   IndustrialPark @relation(fields: [parkId], references: [id], onDelete: Restrict)

  @@unique([userId, shiftStart])
  @@index([userId, shiftStart])
  @@index([parkId, isActive])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt, expiresAt])
}

model OtpChallenge {
  id                     String     @id @default(cuid())
  codeHash               String
  purpose                OtpPurpose
  expiresAt              DateTime
  attempts               Int        @default(0)
  lastAttemptAt          DateTime?
  attemptWindowStartedAt DateTime   @default(now())
  lockedUntil            DateTime?
  consumedAt             DateTime?
  createdAt              DateTime   @default(now())

  phoneNumber String
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber, purpose, expiresAt])
  @@index([phoneNumber, purpose, lockedUntil])
  @@index([phoneNumber, purpose, consumedAt, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  body      String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?

  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, isRead, createdAt])
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  jobId             String                     @unique
  channel           NotificationChannel
  provider          String
  status            NotificationDeliveryStatus @default(PENDING)
  attempt           Int                        @default(0)
  providerErrorCode String?
  correlationId     String?
  terminalAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, status])
  @@index([status, terminalAt])
  @@index([correlationId])
}

model ScopedFile {
  id           String   @id @default(cuid())
  objectKey    String   @unique
  domain       String
  originalName String
  contentType  String
  byteSize     BigInt
  createdAt    DateTime @default(now())

  parkId       String
  park         IndustrialPark @relation(fields: [parkId], references: [id], onDelete: Restrict)
  factoryId    String
  factory      Factory        @relation("FactoryScopedFiles", fields: [factoryId, parkId], references: [id, parkId], onDelete: Cascade)
  uploadedById String
  uploadedBy   User           @relation("ScopedFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([parkId, factoryId, createdAt])
  @@index([factoryId, createdAt])
  @@index([uploadedById, createdAt])
}

/// General-purpose media/documents stored in MinIO (avatars, invoices, docs, logos, …).
/// parkId/factoryId are optional so personal uploads (e.g. avatar) work without a factory scope.
model MediaAsset {
  id           String   @id @default(cuid())
  objectKey    String   @unique
  bucket       String
  domain       String
  originalName String
  contentType  String
  byteSize     Int
  createdAt    DateTime @default(now())

  parkId       String?
  factoryId    String?
  uploadedById String
  uploadedBy   User     @relation("MediaAssetUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([uploadedById, domain, createdAt])
  @@index([domain, createdAt])
  @@index([parkId, factoryId, createdAt])
}

model EmergencyAlert {
  id          String            @id @default(cuid())
  title       String
  description String            @db.Text
  severity    EmergencySeverity
  status      EmergencyStatus   @default(OPEN)
  location    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?

  parkId      String?
  park        IndustrialPark? @relation(fields: [parkId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User            @relation("EmergencyCreator", fields: [createdById], references: [id])
  resolvedById   String?
  resolvedBy     User?   @relation("EmergencyResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?

  @@index([status, severity, createdAt])
  @@index([parkId, status, createdAt])
}

model MarketRate {
  id        String        @id @default(cuid())
  key       MarketRateKey @unique
  label     String
  value     Decimal       @db.Decimal(18, 4)
  unit      String
  updatedAt DateTime      @updatedAt

  updatedById String?
  updatedBy   User?   @relation("MarketRateUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  history     MarketRateHistory[]
}

model MarketRateHistory {
  id         String        @id @default(cuid())
  key        MarketRateKey
  value      Decimal       @db.Decimal(18, 4)
  recordedAt DateTime      @default(now())

  marketRateId String?
  marketRate   MarketRate? @relation(fields: [marketRateId], references: [id], onDelete: SetNull)

  @@index([key, recordedAt])
  @@index([marketRateId, recordedAt])
}

model Feedback {
  id              String          @id @default(cuid())
  subject         String
  body            String          @db.Text
  // Feedback can target either the platform's super-admins (recipientParkId
  // null) or a specific park's managers.
  recipientParkId String?
  recipientPark   IndustrialPark? @relation("FeedbackRecipientPark", fields: [recipientParkId], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())

  senderId String
  sender   User   @relation("FeedbackSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientParkId, createdAt])
}

model AuditLog {
  id              String      @id @default(cuid())
  // This durable actor representation permits the system-bootstrap actor without a user row.
  actorIdentifier String      @default("system")
  action          String
  entity          String
  entityId        String
  changes         Json?
  result          AuditResult @default(SUCCESS)
  correlationId   String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime    @default(now())

  userId String?
  user   User?   @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorIdentifier, createdAt])
  @@index([entity, entityId])
  @@index([correlationId])
}

/// Platform-wide key/value settings (e.g. require wallet for gate-pass creation).
model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}
